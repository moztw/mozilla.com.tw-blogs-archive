{
  "post_id": 1328,
  "title": "為什麼大家喜歡到 Mozilla 上班－Work hard, play hard！",
  "date": "2013-02-04",
  "year": 2013,
  "month": 2,
  "day": 4,
  "categories": [
    "Firefox OS(B2G)",
    "Mozilla"
