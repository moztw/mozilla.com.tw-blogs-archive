{
  "post_id": 6402,
  "title": "如何利用Firefox OS現有的Components打造自己的Web App",
  "date": "2015-04-27",
  "year": 2015,
  "month": 4,
  "day": 27,
  "categories": [
    "Firefox OS(B2G)",
