  "content_html": "<div id=\"main\">\n\t\t<section id=\"primary\">\n\t\t\t<div id=\"profile\">\n\t\t\t\t<div class=\"cover\" style=\"background-image: url();\"><div class=\"scores\"><span class=\"score-label\">累積人氣<span class=\"score\"></span></span><span class=\"score-label\">累積讚數<span class=\"score\"></span></span><span class=\"score-label\">台客獎章<span class=\"score\"></span></span></div></div><div class=\"author-info\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/36/fd0647f9a220bb575bfc00fcb9f76086-bpthumb.jpg\" alt=\"\" class=\"avatar user-36-avatar\" width='150' height='150' /><h2 class=\"name-title\">Evelyn</h2><h3 class=\"description\"></h3><div class=\"bio\"></div></div>\t\t\t</div>\n\n\t\t\t\t\t\t<hr>\n\t\t\t<h2>Evelyn 發表的文章</h2>\n\t\t\t<div id=\"content\" role=\"main\">\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t<div class=\"article-div divider\">\t\t\t\t\n<article id=\"post-2627\" class=\"post-2627 post type-post status-publish format-standard has-post-thumbnail hentry category-b2g\">\n\t<header class=\"entry-header\">\n\t\t<h2 class=\"entry-title\"><a href=\"http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb\" title=\"Permalink to 四週手機變平板 &#8211; 見證奇蹟的時刻\" rel=\"bookmark\">四週手機變平板 &#8211; 見證奇蹟的時刻</a></h2>\n    <p class=\"entry-posted\">\n      <time datetime=\"2014-05-14T10:01:17+00:00\" title=\"2014-05-14T10:01:17+00:00\" class=\"published\">\n        <a title=\"See all posts from May, 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2013/07\" class=\"posted-month\">7月</a>\n        <span class=\"posted-date\">29</span>\n        <a title=\"See all posts from 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2013\" class=\"posted-year\">2013</a>\n      </time>\n    </p>\n      \t\t\t\t<div class=\"entry-meta\">\n      <div class=\"author-meta\" data-author-id=\"36\">\n        <a href=\"http://tech.mozilla.com.tw/posts/author/ehungmozilla-com\">\n          <img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/36/fd0647f9a220bb575bfc00fcb9f76086-bpthumb.jpg\" alt=\"\" class=\"avatar user-36-avatar\" width='24' height='24' /><!--\n       --><div class=\"author-info\">Evelyn</div><!--\n       --><div class=\"author-title\"></div>\n        </a>\n        </div>\n      </div><!-- .entry-meta -->\n\t\t\t</header><!-- .entry-header -->\n\n\n\t<div class=\"thumb-img\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/2013/07/602456_525500794175984_1995303978_n-150x150.jpg\"/></div>\t<div class=\"entry-content half\">\n\t\t一個月前我們在 Computex 2013 發表了 Firefox OS 在平板上的預覽版，吸引了不少人的目光。(如果你還沒看過，本文最後有精華短片。)\r\n\r\n\r\n\r\n雖然只是展示機器，但是當拿在手裡，身為工程師的我們，都會興奮的想讓它變成真的可以動的。\r\n「那麼就來試試看吧！」我們有四週的時間。\r\n現在就把時光倒回去，來看看我們如何用不到一個月的時間，做出可以操作的實機展示版(非成品)。\r\n\r\n.....<a class=\"more\" href=\"http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb\">深入了解</a>  \n\t</div><!-- .entry-content -->\n\t\n  <footer class=\"entry-footer\">\n            <div class=\"entry-category-box\">\n      文章分類：\n      <a href=\"http://tech.mozilla.com.tw/posts/category/b2g\" rel=\"category tag\">Firefox OS(B2G)</a>    </div>\n        <div class=\"entry-social-box\">\n      社群分享：\n     <div class=\"fb-like\" data-href=\"http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb\" data-layout=\"button_count\" data-width=\"40\" data-show-faces=\"false\" data-font=\"arial\"></div>     <!-- Place this tag where you want the +1 button to render. -->\n     \n     <div class=\"google-share\"><div class=\"g-plusone\" name=\"gplus\" data-size=\"medium\" data-annotation=\"bubble\" data-width=\"40\" data-href=\"http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb\"></div></div>     \n    <div class=\"pinterest-share\"><a href=\"http://pinterest.com/pin/create/button/?url=http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb&media=http://tech.mozilla.com.tw/wp-content/uploads/2013/07/602456_525500794175984_1995303978_n-150x150.jpg\" data-pin-do=\"buttonPin\" data-pin-config=\"none\" data-pin-color=\"red\" class=\"pin-it-button\"><img border=\"0\" src=\"//assets.pinterest.com/images/PinExt.png\" title=\"Pin It\" /></a></div>      <div class=\"plurk-share\">\n        <a href=\"javascript: void(window.open('http://www.plurk.com/?qualifier=shares&status=' .concat(encodeURIComponent('http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb')) .concat(' ') .concat('&#40;') .concat(encodeURIComponent(document.title)) .concat('&#41;')));\">\n          <img src=\"https://s.plurk.com/2980c7bcb4eb012159e7701a61cb2e75.png\" border=\"0\" alt=\"plurk share\">\n        </a>\n      </div>\n      <div class=\"comment-share\">\n        <a class=\"comment-button\" href=\"http://tech.mozilla.com.tw/posts/2627/%e5%9b%9b%e9%80%b1%e6%89%8b%e6%a9%9f%e8%ae%8a%e5%b9%b3%e6%9d%bf-%e8%a6%8b%e8%ad%89%e5%a5%87%e8%b9%9f%e7%9a%84%e6%99%82%e5%88%bb#respond\">留言<div class=\"count-bubble\">0</div></a>\n      </div>\n    </div>\n  </footer>\n\n</article><!-- #post-2627 -->\n</div>\n\n\t\t\t\t\n\t\t\t\t\t<div class=\"article-div divider\">\t\t\t\t\n<article id=\"post-942\" class=\"post-942 post type-post status-publish format-standard has-post-thumbnail hentry category-b2g tag-ux-design\">\n\t<header class=\"entry-header\">\n\t\t<h2 class=\"entry-title\"><a href=\"http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe\" title=\"Permalink to Let a wireframe be an app in the iframe\" rel=\"bookmark\">Let a wireframe be an app in the iframe</a></h2>\n    <p class=\"entry-posted\">\n      <time datetime=\"2014-05-14T10:01:17+00:00\" title=\"2014-05-14T10:01:17+00:00\" class=\"published\">\n        <a title=\"See all posts from May, 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2012/10\" class=\"posted-month\">10月</a>\n        <span class=\"posted-date\">22</span>\n        <a title=\"See all posts from 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2012\" class=\"posted-year\">2012</a>\n      </time>\n    </p>\n      \t\t\t\t<div class=\"entry-meta\">\n      <div class=\"author-meta\" data-author-id=\"36\">\n        <a href=\"http://tech.mozilla.com.tw/posts/author/ehungmozilla-com\">\n          <img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/36/fd0647f9a220bb575bfc00fcb9f76086-bpthumb.jpg\" alt=\"\" class=\"avatar user-36-avatar\" width='24' height='24' /><!--\n       --><div class=\"author-info\">Evelyn</div><!--\n       --><div class=\"author-title\"></div>\n        </a>\n        </div>\n      </div><!-- .entry-meta -->\n\t\t\t</header><!-- .entry-header -->\n\n\n\t<div class=\"thumb-img\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/2012/10/v9-150x150.png\"/></div>\t<div class=\"entry-content half\">\n\t\t在 Firefox OS 平台上，一個 App 其實就是一個 iframe。Gaia 團隊成員 (Front-end engineer，簡稱 F2E) 會小心翼翼的檢閱著 UX 設計出來的 wireframe (示意圖)，對照 Gecko Developer (以下簡稱 Dev) 提供的 API，把 App 的功能一個個實作出來，成為 Firefox OS 手機裡真實存在的一個 App。wiref.....<a class=\"more\" href=\"http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe\">深入了解</a>  \n\t</div><!-- .entry-content -->\n\t\n  <footer class=\"entry-footer\">\n            <div class=\"entry-category-box\">\n      文章分類：\n      <a href=\"http://tech.mozilla.com.tw/posts/category/b2g\" rel=\"category tag\">Firefox OS(B2G)</a>    </div>\n        <div class=\"entry-social-box\">\n      社群分享：\n     <div class=\"fb-like\" data-href=\"http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe\" data-layout=\"button_count\" data-width=\"40\" data-show-faces=\"false\" data-font=\"arial\"></div>     <!-- Place this tag where you want the +1 button to render. -->\n     \n     <div class=\"google-share\"><div class=\"g-plusone\" name=\"gplus\" data-size=\"medium\" data-annotation=\"bubble\" data-width=\"40\" data-href=\"http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe\"></div></div>     \n    <div class=\"pinterest-share\"><a href=\"http://pinterest.com/pin/create/button/?url=http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe&media=http://tech.mozilla.com.tw/wp-content/uploads/2012/10/v9-150x150.png\" data-pin-do=\"buttonPin\" data-pin-config=\"none\" data-pin-color=\"red\" class=\"pin-it-button\"><img border=\"0\" src=\"//assets.pinterest.com/images/PinExt.png\" title=\"Pin It\" /></a></div>      <div class=\"plurk-share\">\n        <a href=\"javascript: void(window.open('http://www.plurk.com/?qualifier=shares&status=' .concat(encodeURIComponent('http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe')) .concat(' ') .concat('&#40;') .concat(encodeURIComponent(document.title)) .concat('&#41;')));\">\n          <img src=\"https://s.plurk.com/2980c7bcb4eb012159e7701a61cb2e75.png\" border=\"0\" alt=\"plurk share\">\n        </a>\n      </div>\n      <div class=\"comment-share\">\n        <a class=\"comment-button\" href=\"http://tech.mozilla.com.tw/posts/942/let-a-wireframe-be-an-app-in-the-iframe#respond\">留言<div class=\"count-bubble\">0</div></a>\n      </div>\n    </div>\n  </footer>\n\n</article><!-- #post-942 -->\n</div>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><!-- #content -->\n\t\t\t\n\t\t</section><!-- #primary -->\n\n\t\t<div id=\"secondary\" class=\"widget-area\" role=\"complementary\">\n\t\t\t\t\t\t<aside id=\"moztech_authors-2\" class=\"widget Moztech_Authors_Widget\"><h1 class=\"widget-title\">台客編輯群</h1><div class=\"moztech-authors