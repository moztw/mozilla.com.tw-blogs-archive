  "content_html": "<div id=\"main\">\n\t\t<section id=\"primary\">\n\t\t\t<div id=\"profile\">\n\t\t\t\t<div class=\"cover\" style=\"background-image: url();\"><div class=\"scores\"><span class=\"score-label\">累積人氣<span class=\"score\"></span></span><span class=\"score-label\">累積讚數<span class=\"score\"></span></span><span class=\"score-label\">台客獎章<span class=\"score\"></span></span></div></div><div class=\"author-info\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/30/5cbb786bd6a9fccd9c85d9ea31af1c27-bpthumb.jpg\" alt=\"\" class=\"avatar user-30-avatar\" width='150' height='150' /><h2 class=\"name-title\">小強</h2><h3 class=\"description\"></h3><div class=\"bio\"></div></div>\t\t\t</div>\n\n\t\t\t\t\t\t<hr>\n\t\t\t<h2>小強 發表的文章</h2>\n\t\t\t<div id=\"content\" role=\"main\">\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t<div class=\"article-div divider\">\t\t\t\t\n<article id=\"post-1467\" class=\"post-1467 post type-post status-publish format-standard has-post-thumbnail hentry category-b2g\">\n\t<header class=\"entry-header\">\n\t\t<h2 class=\"entry-title\"><a href=\"http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6\" title=\"Permalink to 跟上時代的潮流 — 談 Firefox OS 自動更新機制\" rel=\"bookmark\">跟上時代的潮流 — 談 Firefox OS 自動更新機制</a></h2>\n    <p class=\"entry-posted\">\n      <time datetime=\"2014-05-14T10:01:17+00:00\" title=\"2014-05-14T10:01:17+00:00\" class=\"published\">\n        <a title=\"See all posts from May, 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2013/04\" class=\"posted-month\">4月</a>\n        <span class=\"posted-date\">09</span>\n        <a title=\"See all posts from 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2013\" class=\"posted-year\">2013</a>\n      </time>\n    </p>\n      \t\t\t\t<div class=\"entry-meta\">\n      <div class=\"author-meta\" data-author-id=\"30\">\n        <a href=\"http://tech.mozilla.com.tw/posts/author/schienmozilla-com\">\n          <img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/30/5cbb786bd6a9fccd9c85d9ea31af1c27-bpthumb.jpg\" alt=\"\" class=\"avatar user-30-avatar\" width='24' height='24' /><!--\n       --><div class=\"author-info\">小強</div><!--\n       --><div class=\"author-title\"></div>\n        </a>\n        </div>\n      </div><!-- .entry-meta -->\n\t\t\t</header><!-- .entry-header -->\n\n\n\t<div class=\"thumb-img\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/2013/02/FFOS-update-flow11-150x150.png\"/></div>\t<div class=\"entry-content half\">\n\t\t一個好的軟體會隨著時代的變遷不斷的演進，為的就是帶給所有用戶『更新、更好、更強大』的使用經驗，因此自動更新機制便是現今軟體不可或缺的功能。Firefox OS 運用了 Firefox 的核心程式碼，自然繼承其自動更新機制，以下就來詳細介紹一隻搭載了 Firefox OS 的手機如何進行更新。\r\n\r\nFirefox OS 的升級包都會包裝在一個 MAR ( Mozilla ARchive) 的特殊壓.....<a class=\"more\" href=\"http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6\">深入了解</a>  \n\t</div><!-- .entry-content -->\n\t\n  <footer class=\"entry-footer\">\n            <div class=\"entry-category-box\">\n      文章分類：\n      <a href=\"http://tech.mozilla.com.tw/posts/category/b2g\" rel=\"category tag\">Firefox OS(B2G)</a>    </div>\n        <div class=\"entry-social-box\">\n      社群分享：\n     <div class=\"fb-like\" data-href=\"http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6\" data-layout=\"button_count\" data-width=\"40\" data-show-faces=\"false\" data-font=\"arial\"></div>     <!-- Place this tag where you want the +1 button to render. -->\n     \n     <div class=\"google-share\"><div class=\"g-plusone\" name=\"gplus\" data-size=\"medium\" data-annotation=\"bubble\" data-width=\"40\" data-href=\"http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6\"></div></div>     \n    <div class=\"pinterest-share\"><a href=\"http://pinterest.com/pin/create/button/?url=http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6&media=http://tech.mozilla.com.tw/wp-content/uploads/2013/02/FFOS-update-flow11-150x150.png\" data-pin-do=\"buttonPin\" data-pin-config=\"none\" data-pin-color=\"red\" class=\"pin-it-button\"><img border=\"0\" src=\"//assets.pinterest.com/images/PinExt.png\" title=\"Pin It\" /></a></div>      <div class=\"plurk-share\">\n        <a href=\"javascript: void(window.open('http://www.plurk.com/?qualifier=shares&status=' .concat(encodeURIComponent('http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6')) .concat(' ') .concat('&#40;') .concat(encodeURIComponent(document.title)) .concat('&#41;')));\">\n          <img src=\"https://s.plurk.com/2980c7bcb4eb012159e7701a61cb2e75.png\" border=\"0\" alt=\"plurk share\">\n        </a>\n      </div>\n      <div class=\"comment-share\">\n        <a class=\"comment-button\" href=\"http://tech.mozilla.com.tw/posts/1467/%e8%b7%9f%e4%b8%8a%e6%99%82%e4%bb%a3%e7%9a%84%e6%bd%ae%e6%b5%81-%e8%ab%87-firefox-os-%e8%87%aa%e5%8b%95%e6%9b%b4%e6%96%b0%e6%a9%9f%e5%88%b6#respond\">留言<div class=\"count-bubble\">0</div></a>\n      </div>\n    </div>\n  </footer>\n\n</article><!-- #post-1467 -->\n</div>\n\n\t\t\t\t\n\t\t\t\t\t<div class=\"article-div divider\">\t\t\t\t\n<article id=\"post-986\" class=\"post-986 post type-post status-publish format-standard hentry category-javascript category-mozilla category-open-source\">\n\t<header class=\"entry-header\">\n\t\t<h2 class=\"entry-title\"><a href=\"http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect\" title=\"Permalink to 跨越語言的邊界 &#8211; 淺談 JS API 與 XPConnect\" rel=\"bookmark\">跨越語言的邊界 &#8211; 淺談 JS API 與 XPConnect</a></h2>\n    <p class=\"entry-posted\">\n      <time datetime=\"2014-05-14T10:01:17+00:00\" title=\"2014-05-14T10:01:17+00:00\" class=\"published\">\n        <a title=\"See all posts from May, 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2012/11\" class=\"posted-month\">11月</a>\n        <span class=\"posted-date\">05</span>\n        <a title=\"See all posts from 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2012\" class=\"posted-year\">2012</a>\n      </time>\n    </p>\n      \t\t\t\t<div class=\"entry-meta\">\n      <div class=\"author-meta\" data-author-id=\"30\">\n        <a href=\"http://tech.mozilla.com.tw/posts/author/schienmozilla-com\">\n          <img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/30/5cbb786bd6a9fccd9c85d9ea31af1c27-bpthumb.jpg\" alt=\"\" class=\"avatar user-30-avatar\" width='24' height='24' /><!--\n       --><div class=\"author-info\">小強</div><!--\n       --><div class=\"author-title\"></div>\n        </a>\n        </div>\n      </div><!-- .entry-meta -->\n\t\t\t</header><!-- .entry-header -->\n\n\n\t\t<div class=\"entry-content \">\n\t\t開發 Mozilla 專案主要會使用兩種程式語言：C++ 與 JavaScript。第一次接觸到這份代碼時，我心中就產生了一個疑問：C++ 是強型態、靜態編譯的語言，而 JavaScript 則是弱型態、直譯式的語言，這兩種特性截然不同的程式語言該如何溝通呢？以下讓我們來分析一下 C++ 與 JavaScript 間若要相互溝通需要打通哪些關節。\r\n\r\n首先要解決的是基本資料型別以及命名空間的問題.....<a class=\"more\" href=\"http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect\">深入了解</a>  \n\t</div><!-- .entry-content -->\n\t\n  <footer class=\"entry-footer\">\n            <div class=\"entry-category-box\">\n      文章分類：\n      <a href=\"http://tech.mozilla.com.tw/posts/category/javascript\" rel=\"category tag\">Javascript</a>、<a href=\"http://tech.mozilla.com.tw/posts/category/mozilla\" rel=\"category tag\">Mozilla</a>、<a href=\"http://tech.mozilla.com.tw/posts/category/open-source\" rel=\"category tag\">Open Source</a>    </div>\n        <div class=\"entry-social-box\">\n      社群分享：\n     <div class=\"fb-like\" data-href=\"http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect\" data-layout=\"button_count\" data-width=\"40\" data-show-faces=\"false\" data-font=\"arial\"></div>     <!-- Place this tag where you want the +1 button to render. -->\n     \n     <div class=\"google-share\"><div class=\"g-plusone\" name=\"gplus\" data-size=\"medium\" data-annotation=\"bubble\" data-width=\"40\" data-href=\"http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect\"></div></div>     \n    <div class=\"pinterest-share\"><a href=\"http://pinterest.com/pin/create/button/?url=http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect&media=http://mozilla.com.tw/assets/css/img/mozcomtw/channels-firefox.png\" data-pin-do=\"buttonPin\" data-pin-config=\"none\" data-pin-color=\"red\" class=\"pin-it-button\"><img border=\"0\" src=\"//assets.pinterest.com/images/PinExt.png\" title=\"Pin It\" /></a></div>      <div class=\"plurk-share\">\n        <a href=\"javascript: void(window.open('http://www.plurk.com/?qualifier=shares&status=' .concat(encodeURIComponent('http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect')) .concat(' ') .concat('&#40;') .concat(encodeURIComponent(document.title)) .concat('&#41;')));\">\n          <img src=\"https://s.plurk.com/2980c7bcb4eb012159e7701a61cb2e75.png\" border=\"0\" alt=\"plurk share\">\n        </a>\n      </div>\n      <div class=\"comment-share\">\n        <a class=\"comment-button\" href=\"http://tech.mozilla.com.tw/posts/986/%e8%b7%a8%e8%b6%8a%e8%aa%9e%e8%a8%80%e7%9a%84%e9%82%8a%e7%95%8c-%e6%b7%ba%e8%ab%87-js-api-%e8%88%87-xpconnect#respond\">留言<div class=\"count-bubble\">1</div></a>\n      </div>\n    </div>\n  </footer>\n\n</article><!-- #post-986 -->\n</div>\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div><!-- #content -->\n\t\t\t\n\t\t</section><!-- #primary -->\n\n\t\t<div id=\"secondary\" class=\"widget-area\" role=\"complementary\">\n\t\t\t\t\t\t<aside id=\"moztech_authors-2\" class=\"widget Moztech_Authors_Widget\"><h1 class=\"widget-title\">台客編輯群</h1><div class=\"moztech-authors-widget\"><a data-author-id=\"70\" href=\"http://tech.mozilla.com.tw/posts/author/szchenmozilla-com\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/70/36b38fa0646d4b8abe3e14a7731a56af-bpthumb.jpg\" alt=\"\" class=\"avatar user-70-avatar\" width='96' height='96' /></a><a data-author-id=\"60\" href=\"http://tech.mozilla.com.tw/posts/author/gasolinmozilla-com\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/60/2af25d5bedc5219a5e66b8d4012b6b11-bpthumb.jpg\" alt=\"\" class=\"avatar user-60-avatar\" width='96' height='96' /></a><a data-author-id=\"41\" href=\"http://tech.mozilla.com.tw/posts/author/rlinmozilla-com\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/41/703970129d2ddcf93e3701c72f86be60-bpthumb.jpg\" alt=\"\" class=\"avatar user-41-avatar\" width='96' height='96' /></a><a data-author-id=\"52\" href=\"http://tech.mozilla.com.tw/posts/author/etsengmozilla-com\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/52/53a7e39c6f825eb03e1771277fce92c0-bpthumb.jpg\" alt=\"\" class=\"avatar user-52-avatar\" width='96' height='96' /></a><a data-author-id=\"33\" href=\"http://tech.mozilla.com.tw/posts/author/pwangmozilla-com\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/avatars/33/1f353454f159004931f05f3952d50664-bpthumb.jpg\" alt=\"\" class=\"avatar user-33-avatar\" width='96' height=