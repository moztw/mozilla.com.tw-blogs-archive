  "local_avatar_path": "",
  "content_html": "<div id=\"main\">\n\t\t<section id=\"primary\">\n\t\t\t<div id=\"profile\">\n\t\t\t\t<div class=\"cover\" style=\"background-image: url();\"><div class=\"scores\"><span class=\"score-label\">累積人氣<span class=\"score\">1303</span></span><span class=\"score-label\">累積讚數<span class=\"score\">50</span></span><span class=\"score-label\">台客獎章<span class=\"score\">5</span></span></div></div><div class=\"author-info\"><img src=\"http://www.gravatar.com/avatar/7f6c1bcb510758ba4c2095022d37c520?d=http://tech.mozilla.com.tw/wp-content/plugins/avatar/mystery-man.jpg&amp;s=150\" alt=\"\" class=\"avatar user-11-avatar\" width='150' height='150' /><h2 class=\"name-title\">Eric</h2><h3 class=\"description\"></h3><div class=\"bio\"></div></div>\t\t\t</div>\n\n\t\t\t\t\t\t<hr>\n\t\t\t<h2>Eric 發表的文章</h2>\n\t\t\t<div id=\"content\" role=\"main\">\n\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t<div class=\"article-div divider\">\t\t\t\t\n<article id=\"post-1317\" class=\"post-1317 post type-post status-publish format-standard has-post-thumbnail hentry category-firefox category-b2g\">\n\t<header class=\"entry-header\">\n\t\t<h2 class=\"entry-title\"><a href=\"http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string\" title=\"Permalink to 鑽進 Firefox OS 開發：淺談 Internal string\" rel=\"bookmark\">鑽進 Firefox OS 開發：淺談 Internal string</a></h2>\n    <p class=\"entry-posted\">\n      <time datetime=\"2014-05-14T10:01:17+00:00\" title=\"2014-05-14T10:01:17+00:00\" class=\"published\">\n        <a title=\"See all posts from May, 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2013/01\" class=\"posted-month\">1月</a>\n        <span class=\"posted-date\">07</span>\n        <a title=\"See all posts from 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2013\" class=\"posted-year\">2013</a>\n      </time>\n    </p>\n      \t\t\t\t<div class=\"entry-meta\">\n      <div class=\"author-meta\" data-author-id=\"11\">\n        <a href=\"http://tech.mozilla.com.tw/posts/author/echoumozilla-com\">\n          <img src=\"http://www.gravatar.com/avatar/7f6c1bcb510758ba4c2095022d37c520?d=http://tech.mozilla.com.tw/wp-content/plugins/avatar/mystery-man.jpg&amp;s=24\" alt=\"\" class=\"avatar user-11-avatar\" width='24' height='24' /><!--\n       --><div class=\"author-info\">Eric</div><!--\n       --><div class=\"author-title\"></div>\n        </a>\n        </div>\n      </div><!-- .entry-meta -->\n\t\t\t</header><!-- .entry-header -->\n\n\n\t<div class=\"thumb-img\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/2013/01/Firefox-OS1-150x150.jpg\"/></div>\t<div class=\"entry-content half\">\n\t\t不論是哪個語言的程式設計師，都時常需要和語言或是框架的字串 (String) 打交道。舉凡傳遞訊息、寫 log，或當作資訊來儲存等等都會用到。今天就來和大家聊聊，在 Firefox OS 裡面，string 是怎麼被使用的。\r\n\r\nInternal string / External string \r\n\r\n首先要提到的是，我們稱在 Mozilla codebase 中所用到的字串為 \"intern.....<a class=\"more\" href=\"http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string\">深入了解</a>  \n\t</div><!-- .entry-content -->\n\t\n  <footer class=\"entry-footer\">\n            <div class=\"entry-category-box\">\n      文章分類：\n      <a href=\"http://tech.mozilla.com.tw/posts/category/firefox\" rel=\"category tag\">Firefox</a>、<a href=\"http://tech.mozilla.com.tw/posts/category/b2g\" rel=\"category tag\">Firefox OS(B2G)</a>    </div>\n        <div class=\"entry-social-box\">\n      社群分享：\n     <div class=\"fb-like\" data-href=\"http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string\" data-layout=\"button_count\" data-width=\"40\" data-show-faces=\"false\" data-font=\"arial\"></div>     <!-- Place this tag where you want the +1 button to render. -->\n     \n     <div class=\"google-share\"><div class=\"g-plusone\" name=\"gplus\" data-size=\"medium\" data-annotation=\"bubble\" data-width=\"40\" data-href=\"http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string\"></div></div>     \n    <div class=\"pinterest-share\"><a href=\"http://pinterest.com/pin/create/button/?url=http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string&media=http://tech.mozilla.com.tw/wp-content/uploads/2013/01/Firefox-OS1-150x150.jpg\" data-pin-do=\"buttonPin\" data-pin-config=\"none\" data-pin-color=\"red\" class=\"pin-it-button\"><img border=\"0\" src=\"//assets.pinterest.com/images/PinExt.png\" title=\"Pin It\" /></a></div>      <div class=\"plurk-share\">\n        <a href=\"javascript: void(window.open('http://www.plurk.com/?qualifier=shares&status=' .concat(encodeURIComponent('http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string')) .concat(' ') .concat('&#40;') .concat(encodeURIComponent(document.title)) .concat('&#41;')));\">\n          <img src=\"https://s.plurk.com/2980c7bcb4eb012159e7701a61cb2e75.png\" border=\"0\" alt=\"plurk share\">\n        </a>\n      </div>\n      <div class=\"comment-share\">\n        <a class=\"comment-button\" href=\"http://tech.mozilla.com.tw/posts/1317/%e9%91%bd%e9%80%b2-firefox-os-%e9%96%8b%e7%99%bc%ef%bc%9a%e6%b7%ba%e8%ab%87-internal-string#respond\">留言<div class=\"count-bubble\">0</div></a>\n      </div>\n    </div>\n  </footer>\n\n</article><!-- #post-1317 -->\n</div>\n\n\t\t\t\t\n\t\t\t\t\t<div class=\"article-div divider\">\t\t\t\t\n<article id=\"post-143\" class=\"post-143 post type-post status-publish format-standard has-post-thumbnail hentry category-b2g\">\n\t<header class=\"entry-header\">\n\t\t<h2 class=\"entry-title\"><a href=\"http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81\" title=\"Permalink to 初登場！台客艾瑞克報到！\" rel=\"bookmark\">初登場！台客艾瑞克報到！</a></h2>\n    <p class=\"entry-posted\">\n      <time datetime=\"2014-05-14T10:01:17+00:00\" title=\"2014-05-14T10:01:17+00:00\" class=\"published\">\n        <a title=\"See all posts from May, 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2012/05\" class=\"posted-month\">5月</a>\n        <span class=\"posted-date\">28</span>\n        <a title=\"See all posts from 2014\" href=\"http://tech.mozilla.com.tw/posts/date/2012\" class=\"posted-year\">2012</a>\n      </time>\n    </p>\n      \t\t\t\t<div class=\"entry-meta\">\n      <div class=\"author-meta\" data-author-id=\"11\">\n        <a href=\"http://tech.mozilla.com.tw/posts/author/echoumozilla-com\">\n          <img src=\"http://www.gravatar.com/avatar/7f6c1bcb510758ba4c2095022d37c520?d=http://tech.mozilla.com.tw/wp-content/plugins/avatar/mystery-man.jpg&amp;s=24\" alt=\"\" class=\"avatar user-11-avatar\" width='24' height='24' /><!--\n       --><div class=\"author-info\">Eric</div><!--\n       --><div class=\"author-title\"></div>\n        </a>\n        </div>\n      </div><!-- .entry-meta -->\n\t\t\t</header><!-- .entry-header -->\n\n\n\t<div class=\"thumb-img\"><img src=\"http://tech.mozilla.com.tw/wp-content/uploads/2012/05/jonas-sicking-250x375-150x150.jpg\"/></div>\t<div class=\"entry-content half\">\n\t\t大家好！我是愛笑愛開槓愛看棒球愛打網球愛寫程式而且最愛台丸的謀智台客──艾瑞克。\n初次見面，請多指教。m(_._)m\n今年一月，我成為 Mozilla 台灣的一員，其實沒想到自己會這麼快就進外商工作，以前常聽人說「某某某進外商工作了耶」，感覺那位某某某就是很有經驗的樣子，但我仍然未達而立之年（謎之聲：好像也相去不遠），就能夠到國際級的公司來見見世面，真的是很難得的一次機會。\n在加入 Mozilla.....<a class=\"more\" href=\"http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81\">深入了解</a>  \n\t</div><!-- .entry-content -->\n\t\n  <footer class=\"entry-footer\">\n            <div class=\"entry-category-box\">\n      文章分類：\n      <a href=\"http://tech.mozilla.com.tw/posts/category/b2g\" rel=\"category tag\">Firefox OS(B2G)</a>    </div>\n        <div class=\"entry-social-box\">\n      社群分享：\n     <div class=\"fb-like\" data-href=\"http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81\" data-layout=\"button_count\" data-width=\"40\" data-show-faces=\"false\" data-font=\"arial\"></div>     <!-- Place this tag where you want the +1 button to render. -->\n     \n     <div class=\"google-share\"><div class=\"g-plusone\" name=\"gplus\" data-size=\"medium\" data-annotation=\"bubble\" data-width=\"40\" data-href=\"http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81\"></div></div>     \n    <div class=\"pinterest-share\"><a href=\"http://pinterest.com/pin/create/button/?url=http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81&media=http://tech.mozilla.com.tw/wp-content/uploads/2012/05/jonas-sicking-250x375-150x150.jpg\" data-pin-do=\"buttonPin\" data-pin-config=\"none\" data-pin-color=\"red\" class=\"pin-it-button\"><img border=\"0\" src=\"//assets.pinterest.com/images/PinExt.png\" title=\"Pin It\" /></a></div>      <div class=\"plurk-share\">\n        <a href=\"javascript: void(window.open('http://www.plurk.com/?qualifier=shares&status=' .concat(encodeURIComponent('http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81')) .concat(' ') .concat('&#40;') .concat(encodeURIComponent(document.title)) .concat('&#41;')));\">\n          <img src=\"https://s.plurk.com/2980c7bcb4eb012159e7701a61cb2e75.png\" border=\"0\" alt=\"plurk share\">\n        </a>\n      </div>\n      <div class=\"comment-share\">\n        <a class=\"comment-button\" href=\"http://tech.mozilla.com.tw/posts/143/%e5%88%9d%e7%99%bb%e5%a0%b4%ef%bc%81%e5%8f%b0%e5%ae%a2%e8%89%be%e7%91%9e%e5%85%8b%e5%a0%b1%e5%88%b0%ef%bc%81#respond\">留言<div class=\"count-bubble\">