  "archive_url": "https://web.archive.org/web/20190824003748/https://blog.mozilla.com.tw/posts/3179/%e6%90%9c%e5%b0%8b-app-%e6%89%8b%e6%a9%9f%e6%87%89%e7%94%a8%e7%a8%8b%e5%bc%8f-%e2%94%80-%e9%96%8b%e7%99%bc%e8%80%85%e7%9a%84-firefox-os-%e8%ae%93-html-5-%e5%be%97%e4%bb%a5%e5%ae%8c%e5%85%a8",
