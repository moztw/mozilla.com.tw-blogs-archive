  "post_id": 6367,
  "title": "如何切換在 Firefox 中的 PDF 檢視器",
  "date": "2014-09-30",
  "year": 2014,
  "month": 9,
  "day": 30,
  "categories": [
    "Firefox"
  ],
  "tags": [
    "Firefox"
  ],
  "author": "",
  "original_url": "https://blog.mozilla.com.tw/?p=6367",
